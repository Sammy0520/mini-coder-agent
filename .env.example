# Copy these values into environment variables. Never commit a real API key.
CODING_AGENT_API_KEY=replace-me
CODING_AGENT_BASE_URL=https://api.openai.com/v1
CODING_AGENT_MODEL=replace-with-a-tool-calling-model
CODING_AGENT_WIRE_API=responses
CODING_AGENT_REASONING_EFFORT=medium
CODING_AGENT_VERBOSITY=medium

# Optional runtime controls
CODING_AGENT_MAX_STEPS=20
CODING_AGENT_MAX_SECONDS=900
CODING_AGENT_MAX_MODEL_CALLS=40
CODING_AGENT_MAX_TOOL_CALLS=100
CODING_AGENT_COMMAND_TIMEOUT=60
CODING_AGENT_MAX_TOOL_OUTPUT=12000
CODING_AGENT_MAX_TOTAL_TOOL_OUTPUT=200000
CODING_AGENT_MAX_TOTAL_TOKENS=500000
CODING_AGENT_MAX_RETRIES=2
CODING_AGENT_RETRY_BASE_SECONDS=0.5
CODING_AGENT_RETRY_MAX_SECONDS=8
CODING_AGENT_MODEL_TIMEOUT_SECONDS=120
CODING_AGENT_CONTEXT_CHARS=80000
