# Copy these values into environment variables. Never commit a real API key.
CODING_AGENT_API_KEY=replace-me
CODING_AGENT_BASE_URL=https://api.openai.com/v1
CODING_AGENT_MODEL=replace-with-a-tool-calling-model
CODING_AGENT_WIRE_API=responses
CODING_AGENT_REASONING_EFFORT=medium
CODING_AGENT_VERBOSITY=medium
CODING_AGENT_STREAMING=true
CODING_AGENT_PROMPT_CACHE=true
CODING_AGENT_PROMPT_CACHE_KEY=mini-coder-agent-v1
CODING_AGENT_SUBAGENTS=true
CODING_AGENT_MAX_PARALLEL_SUBAGENTS=2
CODING_AGENT_MAX_SUBAGENT_BATCHES=2
CODING_AGENT_MAX_SUBAGENT_STEPS=6
CODING_AGENT_MAX_SUBAGENT_SECONDS=300
CODING_AGENT_MAX_SUBAGENT_MODEL_CALLS=5
CODING_AGENT_MAX_SUBAGENT_TOOL_CALLS=16
CODING_AGENT_MAX_SUBAGENT_TOTAL_TOKENS=40000
CODING_AGENT_MAX_SUBAGENT_CONTEXT_TOKENS=8000
CODING_AGENT_MAX_SUBAGENT_WORKSPACE_FILES=5000
CODING_AGENT_MAX_SUBAGENT_WORKSPACE_BYTES=50000000

# Optional runtime controls
CODING_AGENT_MAX_STEPS=20
CODING_AGENT_MAX_SECONDS=900
CODING_AGENT_MAX_MODEL_CALLS=40
CODING_AGENT_MAX_TOOL_CALLS=100
CODING_AGENT_COMMAND_TIMEOUT=60
CODING_AGENT_MAX_TOOL_OUTPUT=12000
CODING_AGENT_MAX_TOTAL_TOOL_OUTPUT=200000
CODING_AGENT_MAX_TOTAL_TOKENS=500000
CODING_AGENT_MAX_RETRIES=2
CODING_AGENT_RETRY_BASE_SECONDS=0.5
CODING_AGENT_RETRY_MAX_SECONDS=8
CODING_AGENT_MODEL_TIMEOUT_SECONDS=120
CODING_AGENT_CONTEXT_CHARS=80000
CODING_AGENT_MAX_RESPONSE_TOOL_CALLS=8
CODING_AGENT_MAX_RESPONSE_WRITE_CALLS=3
CODING_AGENT_MAX_RESPONSE_WRITE_CHARS=18000
CODING_AGENT_PARALLEL_READ_TOOLS=true
CODING_AGENT_SPECULATIVE_FINISH=false
CODING_AGENT_SPECULATIVE_FINISH_DELAY_MS=800
CODING_AGENT_SPECULATIVE_FINISH_REASONING_EFFORT=low
